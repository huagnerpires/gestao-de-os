      allow write: if true;
      allow delete: if true;
    }

    match /EQUIPAMENTOSCADASTRO/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /CORRETIVAS/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /IMAGENS/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /EQUIPAMENTOS_EMPRESA/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /TERMOGRAFIA/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
